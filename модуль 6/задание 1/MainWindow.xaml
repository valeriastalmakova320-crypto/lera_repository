<!-- Окно программы. Без окна пользователю негде работать. -->
<!-- x:Class - имя класса из C#. Чтобы окно знало, откуда брать код. -->
<!-- xmlns - словарь языка XAML. Без него VS не поймёт теги. -->
<!-- Title, Height, Width - надпись шапки и размеры. Чтобы окно было видно и имело имя. -->
<Window x:Class="задание_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет сотрудников" Height="450" Width="800">
    <!-- Сетка. Чтобы элементы стояли ровно: поля сверху, таблица по центру, кнопки снизу. -->
    <!-- Margin=10. Чтобы элементы не прилипали к краю окна. -->
    <Grid Margin="10">
        <!-- Список строк сетки. Говорим, сколько строк и какой высоты. -->
        <Grid.RowDefinitions>
            <!-- Строка 1, высота по содержимому. Для полей ввода - им много места не надо. -->
            <RowDefinition Height="Auto"/>
            <!-- Строка 2, займёт всё оставшееся место. Для таблицы - она должна расти. -->
            <RowDefinition Height="*"/>
            <!-- Строка 3, по содержимому. Для кнопок - им хватит своей высоты. -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Панель с полями ввода, слева направо, в первой строке. Здесь пользователь вводит данные. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <!-- Надпись "Имя:". Объясняет пользователю, что вводить в поле справа. -->
            <TextBlock Text="Имя:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <!-- Поле ввода. Чтобы пользователь написал имя сотрудника. -->
            <TextBox x:Name="txtName" Width="120" Margin="0,0,10,0"/>
            <!-- Надпись "Должность:". Объясняет назначение поля справа. -->
            <TextBlock Text="Должность:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <!-- Поле ввода должности. Чтобы пользователь написал должность. -->
            <TextBox x:Name="txtPosition" Width="120" Margin="0,0,10,0"/>
            <!-- Надпись "Зарплата:". Подсказка, что вводить цифрами. -->
            <TextBlock Text="Зарплата:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <!-- Поле ввода зарплаты. Чтобы пользователь написал зарплату. -->
            <TextBox x:Name="txtSalary" Width="80"/>
        </StackPanel>
        <!-- Таблица. Показать пользователю всех сотрудников из базы. -->
        <!-- AutoGenerateColumns. Колонки создадутся сами по столбцам из базы. -->
        <!-- IsReadOnly. Чтобы нельзя было случайно менять данные прямо в таблице. -->
        <!-- SelectionMode Single. Чтобы выбрать можно было только одного сотрудника. -->
        <!-- SelectionChanged. Когда кликнули по строке - заполним поля ввода. -->
        <DataGrid Grid.Row="1" x:Name="dgEmployees"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="dgEmployees_SelectionChanged"/>
        <!-- Панель кнопок, в третьей строке. Чтобы у пользователя были действия. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <!-- Кнопка "Добавить". Сохранить введённого сотрудника в базу. -->
            <Button x:Name="btnAdd" Content="Добавить" Width="100" Margin="0,0,10,0" Click="btnAdd_Click"/>
            <!-- Кнопка "Редактировать". Сохранить изменения выбранного сотрудника. -->
            <Button x:Name="btnEdit" Content="Редактировать" Width="120" Margin="0,0,10,0" Click="btnEdit_Click"/>
            <!-- Кнопка "Удалить". Убрать выбранного сотрудника из базы. -->
            <Button x:Name="btnDelete" Content="Удалить" Width="100" Margin="0,0,10,0" Click="btnDelete_Click"/>
            <!-- Кнопка "Обновить". Перечитать базу, если что-то поменялось. -->
            <Button x:Name="btnRefresh" Content="Обновить" Width="100" Click="btnRefresh_Click"/>
        </StackPanel>
    </Grid>
</Window>