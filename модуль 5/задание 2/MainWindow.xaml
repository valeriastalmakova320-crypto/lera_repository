<Window x:Class="задание_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:задание_1"
        mc:Ignorable="d"
        Title="Текстовый редактор" Height="450" Width="800">
    <Grid>
        <!-- Контейнер для размещения элементов -->
        <Grid.RowDefinitions>
            <!-- Описание строк окна -->
            <RowDefinition Height="50"/>
            <!-- Первая строка высотой 50 пикселей для кнопок -->
            <RowDefinition Height="*"/>
            <!-- Вторая строка занимает все оставшееся место для текста -->
        </Grid.RowDefinitions>
        <!-- Конец описания строк -->

        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="LightGray">
            <!-- Панель сверху для кнопок -->
            <Button x:Name="btnOpen" Content="Открыть" Width="100" Height="30" Margin="10" Click="BtnOpen_Click"/>
            <!-- Кнопка открытия файла -->
            <Button x:Name="btnSave" Content="Сохранить" Width="100" Height="30" Margin="10" Click="BtnSave_Click"/>
            <!-- Кнопка сохранения файла -->
        </StackPanel>
        <!-- Конец панели с кнопками -->

        <TextBox x:Name="txtEditor" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14"/>
        <!-- Поле для ввода и редактирования текста -->
    </Grid>
    <!-- Конец контейнера -->
</Window>