<Window x:Class="задание_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:задание_1"
        mc:Ignorable="d"
        Title="Калькулятор" Height="500" Width="350">
    <!-- Контейнер для размещения элементов -->
    <Grid>
        <!-- Описание строк окна -->
        <Grid.RowDefinitions>
            <!-- Первая строка высотой 80 пикселей для экрана калькулятора -->
            <RowDefinition Height="80"/>
            <!-- Вторая строка занимает все оставшееся место для кнопок -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Экран калькулятора, где показывается число -->
        <TextBox x:Name="txtDisplay" Grid.Row="0" FontSize="32" Text="0" TextAlignment="Right" VerticalContentAlignment="Center" IsReadOnly="True" Margin="10"/>

        <!-- Сетка для кнопок, отступ 10 пикселей со всех сторон -->
        <Grid Grid.Row="1" Margin="10">
            <!-- Описание колонок сетки, четыре равные колонки -->
            <Grid.ColumnDefinitions>
                <!-- Первая колонка занимает равную часть ширины -->
                <ColumnDefinition Width="*"/>
                <!-- Вторая колонка занимает равную часть ширины -->
                <ColumnDefinition Width="*"/>
                <!-- Третья колонка занимает равную часть ширины -->
                <ColumnDefinition Width="*"/>
                <!-- Четвертая колонка занимает равную часть ширины -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Описание строк сетки, пять равных строк -->
            <Grid.RowDefinitions>
                <!-- Первая строка кнопок -->
                <RowDefinition Height="*"/>
                <!-- Вторая строка кнопок -->
                <RowDefinition Height="*"/>
                <!-- Третья строка кнопок -->
                <RowDefinition Height="*"/>
                <!-- Четвертая строка кнопок -->
                <RowDefinition Height="*"/>
                <!-- Пятая строка кнопок -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Первый ряд кнопок -->
            <!-- Кнопка C для сброса всех вычислений -->
            <Button Grid.Row="0" Grid.Column="0" Content="C" FontSize="20" Margin="3" Click="BtnClear_Click"/>
            <!-- Кнопка деления -->
            <Button Grid.Row="0" Grid.Column="1" Content="/" FontSize="20" Margin="3" Click="BtnOperator_Click"/>
            <!-- Кнопка умножения -->
            <Button Grid.Row="0" Grid.Column="2" Content="*" FontSize="20" Margin="3" Click="BtnOperator_Click"/>
            <!-- Кнопка вычитания -->
            <Button Grid.Row="0" Grid.Column="3" Content="-" FontSize="20" Margin="3" Click="BtnOperator_Click"/>

            <!-- Второй ряд кнопок -->
            <!-- Кнопка с цифрой 7 -->
            <Button Grid.Row="1" Grid.Column="0" Content="7" FontSize="20" Margin="3" Click="BtnDigit_Click"/>
            <!-- Кнопка с цифрой 8 -->
            <Button Grid.Row="1" Grid.Column="1" Content="8" FontSize="20" Margin="3" Click="BtnDigit_Click"/>
            <!-- Кнопка с цифрой 9 -->
            <Button Grid.Row="1" Grid.Column="2" Content="9" FontSize="20" Margin="3" Click="BtnDigit_Click"/>
            <!-- Кнопка сложения -->
            <Button Grid.Row="1" Grid.Column="3" Content="+" FontSize="20" Margin="3" Click="BtnOperator_Click"/>

            <!-- Третий ряд кнопок -->
            <!-- Кнопка с цифрой 4 -->
            <Button Grid.Row="2" Grid.Column="0" Content="4" FontSize="20" Margin="3" Click="BtnDigit_Click"/>
            <!-- Кнопка с цифрой 5 -->
            <Button Grid.Row="2" Grid.Column="1" Content="5" FontSize="20" Margin="3" Click="BtnDigit_Click"/>
            <!-- Кнопка с цифрой 6 -->
            <Button Grid.Row="2" Grid.Column="2" Content="6" FontSize="20" Margin="3" Click="BtnDigit_Click"/>
            <!-- Кнопка равно, занимает два ряда по вертикали -->
            <Button Grid.Row="2" Grid.Column="3" Grid.RowSpan="2" Content="=" FontSize="20" Margin="3" Click="BtnEquals_Click"/>

            <!-- Четвертый ряд кнопок -->
            <!-- Кнопка с цифрой 1 -->
            <Button Grid.Row="3" Grid.Column="0" Content="1" FontSize="20" Margin="3" Click="BtnDigit_Click"/>
            <!-- Кнопка с цифрой 2 -->
            <Button Grid.Row="3" Grid.Column="1" Content="2" FontSize="20" Margin="3" Click="BtnDigit_Click"/>
            <!-- Кнопка с цифрой 3 -->
            <Button Grid.Row="3" Grid.Column="2" Content="3" FontSize="20" Margin="3" Click="BtnDigit_Click"/>

            <!-- Пятый ряд кнопок -->
            <!-- Кнопка с цифрой 0, занимает две колонки по ширине -->
            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="0" FontSize="20" Margin="3" Click="BtnDigit_Click"/>
            <!-- Кнопка с запятой для десятичных дробей -->
            <Button Grid.Row="4" Grid.Column="2" Content="." FontSize="20" Margin="3" Click="BtnDot_Click"/>
            <!-- Кнопка назад для удаления последнего символа -->
            <Button Grid.Row="4" Grid.Column="3" Content="←" FontSize="20" Margin="3" Click="BtnBack_Click"/>
        </Grid>
    </Grid>
</Window>