<Window x:Class="задание_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:задание_1"
        mc:Ignorable="d"
        Title="Просмотр изображений" Height="600" Width="900">
    <!-- Контейнер для размещения элементов -->
    <Grid>
        <!-- Описание строк окна -->
        <Grid.RowDefinitions>
            <!-- Первая строка для кнопок управления -->
            <RowDefinition Height="60"/>
            <!-- Вторая строка занимает все оставшееся место для изображения -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель сверху для кнопок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="LightGray">
            <!-- Кнопка выбора изображения на компьютере -->
            <Button x:Name="btnOpen" Content="Открыть" Width="100" Height="30" Margin="10" Click="BtnOpen_Click"/>
            <!-- Кнопка увеличения изображения -->
            <Button x:Name="btnZoomIn" Content="Увеличить" Width="100" Height="30" Margin="10" Click="BtnZoomIn_Click"/>
            <!-- Кнопка уменьшения изображения -->
            <Button x:Name="btnZoomOut" Content="Уменьшить" Width="100" Height="30" Margin="10" Click="BtnZoomOut_Click"/>
            <!-- Кнопка сброса масштаба к исходному -->
            <Button x:Name="btnReset" Content="Сбросить" Width="100" Height="30" Margin="10" Click="BtnReset_Click"/>
        </StackPanel>

        <!-- Область для показа изображения, с прокруткой если картинка больше окна -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <!-- Картинка, которую будем показывать. Stretch=None значит показывать в реальном размере -->
            <Image x:Name="imgView" Stretch="None"/>
        </ScrollViewer>
    </Grid>
</Window>