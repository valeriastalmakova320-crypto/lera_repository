<Window x:Class="задание_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:задание_1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!-- Контейнер для разделения окна на части -->
        <Grid.ColumnDefinitions>
            <!-- Описание колонок окна -->
            <ColumnDefinition Width="150"/>
            <!-- Первая колонка шириной 150 пикселей для кнопок -->
            <ColumnDefinition Width="*"/>
            <!-- Вторая колонка занимает все оставшееся место для холста -->
        </Grid.ColumnDefinitions>
        <!-- Конец описания колонок -->

        <StackPanel Grid.Column="0" Background="LightGray">
            <!-- Панель слева в первой колонке с серым фоном -->
            <Button x:Name="btnLine" Content="Линия" Height="40" Margin="10" Click="BtnLine_Click"/>
            <!-- Кнопка выбора линии -->
            <Button x:Name="btnCircle" Content="Круг" Height="40" Margin="10" Click="BtnCircle_Click"/>
            <!-- Кнопка выбора круга -->
            <Button x:Name="btnSquare" Content="Квадрат" Height="40" Margin="10" Click="BtnSquare_Click"/>
            <!-- Кнопка выбора квадрата -->
            <TextBlock x:Name="txtStatus" Text="Выберите фигуру" Margin="10" HorizontalAlignment="Center"/>
            <!-- Текст показывает, какая фигура выбрана -->
        </StackPanel>
        <!-- Конец панели с кнопками -->

        <Canvas x:Name="paintCanvas" Grid.Column="1" Background="White" MouseLeftButtonDown="PaintCanvas_MouseLeftButtonDown"/>
        <!-- Белый холст для рисования -->
    </Grid>
    <!-- Конец контейнера -->
</Window>
