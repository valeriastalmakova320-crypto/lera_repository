<Window x:Class="задание_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:задание_1"
        mc:Ignorable="d"
        Title="Менеджер задач" Height="500" Width="600">
    <!-- Контейнер для размещения элементов -->
    <Grid>
        <!-- Описание строк окна -->
        <Grid.RowDefinitions>
            <!-- Первая строка для поля ввода и кнопки добавления -->
            <RowDefinition Height="60"/>
            <!-- Вторая строка для кнопок удаления и отметки -->
            <RowDefinition Height="60"/>
            <!-- Третья строка занимает все оставшееся место для списка задач -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель сверху для поля ввода -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="LightGray">
            <!-- Поле для ввода текста новой задачи -->
            <TextBox x:Name="txtTask" Width="400" Height="30" Margin="10" VerticalContentAlignment="Center" FontSize="14"/>
            <!-- Кнопка добавления задачи -->
            <Button x:Name="btnAdd" Content="Добавить" Width="120" Height="30" Margin="10" Click="BtnAdd_Click"/>
        </StackPanel>

        <!-- Панель для кнопок управления -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Background="LightGray">
            <!-- Кнопка удаления выбранной задачи -->
            <Button x:Name="btnDelete" Content="Удалить" Width="120" Height="30" Margin="10" Click="BtnDelete_Click"/>
            <!-- Кнопка отметки задачи как выполненной -->
            <Button x:Name="btnDone" Content="Отметить выполненной" Width="200" Height="30" Margin="10" Click="BtnDone_Click"/>
        </StackPanel>

        <!-- Список задач -->
        <ListBox x:Name="listTasks" Grid.Row="2" Margin="10" FontSize="14"/>
    </Grid>
</Window>